

# -----------------------------------------------------------------------------
# ENVIRONMENT CONFIGURATION INSTRUCTIONS
# -----------------------------------------------------------------------------
# This is an example environment file for the project. It is tracked by git and
# does NOT contain any sensitive information or secrets.
#
# To get started:
# 1. Copy this file and rename the copy to ".env" at the root of the project.
# 2. Fill in the required values for each key in your new ".env" file.
#    (You may need to obtain secrets or API keys from the project maintainer or
#     relevant documentation.)
# 3. NEVER commit your ".env" file or any secrets to version control. The ".env"
#    file is already included in ".gitignore" to help prevent this.
#
# If you add new environment variables to the project, please update this
# ".env.example" file accordingly so future contributors know what is required.
#
# EXAMPLE OF VARS:
# API_VERSIONS = ["current/v1", "next/v2", "deprecated/v3"]
# REDIS_URL = ' redis://localhost:6379/0'
# API_VERSIONS = ["v1"]
# API_VERSION = API_VERSIONS[0]
# REDIS_URL = ' redis://localhost:6379/0'

# FAKE_DATABASE_NAME = "afake_database.db"
# FAKE_DATABASE_URL = "sqlite:///./src/app/db/shorties_database.db"

# DEV_ENV = "True"
# DEV_DATABASE_NAME = "dev_database_name"
# DEV_DATABASE_URL = "dev_database_url"
# DEV_DATABASE_USER = 'postgres_user'
# DEV_DATABASE_DB = 'postgres_dev_database_name'
# DEV_DATABASE_PASSWORD = 'postgres_dev_database_password'
# DEV_DATABASE_HOST = 'postgres_dev_database_host'
# DEV_DATABASE_PORT = 5000-65535


#
# -----------------------------------------------------------------------------
# END
# -----------------------------------------------------------------------------
